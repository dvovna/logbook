{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@modules/clients": ["src/clients/index"],
      "@modules/clients/*": ["src/clients/*"],
      "@common/*": ["src/common/*"],
      "@modules/holidays": ["src/holidays/index"],
      "@modules/holidays/*": ["src/holidays/*"],
      "@modules/request-workflows": ["src/request-workflows/index"],
      "@modules/request-workflows/*": ["src/request-workflows/*"],
      "@modules/slack": ["src/slack/index"],
      "@modules/slack/*": ["src/slack/*"],
      "@modules/slack-communication": ["src/slack-communication/index"],
      "@modules/slack-communication/*": ["src/slack-communication/*"],
      "@modules/slack-teams": ["src/slack-teams/index"],
      "@modules/slack-teams/*": ["src/slack-teams/*"],
      "@modules/team-setup": ["src/team-setup/index"],
      "@modules/team-setup/*": ["src/team-setup/*"],
      "@modules/teams": ["src/teams/index"],
      "@modules/teams/*": ["src/teams/*"],
      "@modules/user-data-import": ["src/user-data-import/index"],
      "@modules/user-data-import/*": ["src/user-data-import/*"],
      "@modules/users": ["src/users/index"],
      "@modules/users/*": ["src/users/*"],
      "@modules/vacation-policies": ["src/vacation-policies/index"],
      "@modules/vacation-policies/*": ["src/vacation-policies/*"],
      "@modules/vacation-requests": ["src/vacation-requests/index"],
      "@modules/vacation-requests/*": ["src/vacation-requests/*"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
