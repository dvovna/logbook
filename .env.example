# Copy to .env. Only the Postgres and Slack values are required.

PORT=3000

# Postgres, for the data and the job queue. Locally postgresql://postgres:postgres@127.0.0.1:54322/postgres; on
# Supabase the session pooler string from "Connect" (port 5432, not 6543).
DATABASE_URL=
# Optional: connections the app's pool may hold (default 10); the job queue
# holds 3 more. Keep both together under the Supabase project's "Pool Size".
# DATABASE_POOL_SIZE=10
# Optional: how many background jobs run at once (default 4); the others wait,
# saved. Keep it under DATABASE_POOL_SIZE.
# JOBS_CONCURRENCY=4

# Slack app, from "Basic Information" (the Signing Secret goes into
# SLACK_SIGN_IN_SECRET). The redirect URI is https://<your-domain>/api/slack/oauth/redirect.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGN_IN_SECRET=
SLACK_REDIRECT_URI=

# Encrypts the bot tokens stored in the database: 32 random bytes, base64.
# Generate one with `openssl rand -base64 32`. Without it the app can't read
# the stored tokens, so keep it with the other secrets.
SLACK_TOKEN_ENCRYPTION_KEY=

# Optional: only these Slack workspaces may install the app on this server,
# e.g. T0123ABCD,T0456EFGH. Empty lets every workspace with the install link.
ALLOWED_SLACK_TEAM_IDS=

# Optional error tracking: unexpected errors go to this Sentry project, with no
# request data or people's details. Empty sends nothing anywhere.
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production

# Optional, these are the defaults.
# Days an uninstalled workspace's data is kept; installing again within them
# restores it. 0 deletes it when the app is uninstalled.
# UNINSTALLED_DATA_RETENTION_DAYS=30
# Days the files of receipts are kept (the receipt itself stays); 1095 is three
# years.
# RECEIPT_FILE_RETENTION_DAYS=1095
# MIN_YEAR=2020
# MAX_YEAR=2035
# MAX_REQUESTS_PER_USER=500
# MAX_PENDING_REQUESTS_PER_USER=5
# MAX_TEAMS_PER_SLACK_TEAM=10
# MAX_CLIENTS_PER_SLACK_TEAM=10
# MAX_PROJECTS_PER_SLACK_TEAM=10
# MAX_POLICIES_PER_SLACK_TEAM=10
# MAX_COMPANY_HOLIDAYS_PER_COMPANY_PER_YEAR=5

# Install the app by opening https://<your-domain>/api/slack/install
# ("Install to Workspace" in the Slack app settings skips the OAuth redirect).
