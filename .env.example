# Copy to .env. Only the Supabase and Slack values are required.

PORT=3000

# Supabase project: the API URL and the service role key (Project Settings ->
# API). For the local stack, take API_URL and SERVICE_ROLE_KEY from
# `npx supabase@latest status -o env`.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Slack app, from "Basic Information" (the Signing Secret goes into
# SLACK_SIGN_IN_SECRET). The redirect URI is https://<your-domain>/api/slack/oauth/redirect.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGN_IN_SECRET=
SLACK_REDIRECT_URI=

# Optional, these are the defaults.
# MIN_YEAR=2020
# MAX_YEAR=2035
# MAX_REQUESTS_PER_USER=500
# MAX_PENDING_REQUESTS_PER_USER=5
# MAX_TEAMS_PER_SLACK_TEAM=10
# MAX_CLIENTS_PER_SLACK_TEAM=10
# MAX_PROJECTS_PER_SLACK_TEAM=10
# MAX_POLICIES_PER_SLACK_TEAM=10
# MAX_COMPANY_HOLIDAYS_PER_COMPANY_PER_YEAR=5

# Install the app by opening https://<your-domain>/api/slack/install
# ("Install to Workspace" in the Slack app settings skips the OAuth redirect).
